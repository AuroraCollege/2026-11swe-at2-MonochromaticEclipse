class Game:
    def __init__(self, grid_size=20):
        self.grid_size = grid_size
        self.snake = Snake()
        self.food = Food(grid_size)
        self.score = 0
        self.game_over = false

    def update(self):
        if self.game_over
            return
        self.snake.move()
    
